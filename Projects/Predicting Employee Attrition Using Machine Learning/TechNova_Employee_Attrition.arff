@attribute JobSatisfaction numeric
@attribute WorkLifeBalance numeric
@attribute EducationLevel numeric
@attribute TrainingHoursLastYear numeric
@attribute OverTime {Yes, No}
@attribute PerformanceRating numeric
@attribute Attrition {Yes, No}

